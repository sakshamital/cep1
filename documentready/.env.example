# Flask & Security
SECRET_KEY=change-this-to-a-secure-random-secret-in-production
FLASK_ENV=development
SESSION_COOKIE_SECURE=False

# Database Persistence (Defaults to SQLite in instance/documentready.db if unset; PostgreSQL supported)
DATABASE_URL=sqlite:///instance/documentready.db
# DATABASE_URL=postgresql://username:password@localhost:5432/documentready

# Initial Administrator Provisioning
INITIAL_ADMIN_PASSWORD=Admin@DocReady2026

# Official Source Monitoring Configuration
MONITOR_REQUEST_TIMEOUT=15
ENABLE_BACKGROUND_SCHEDULER=False

# Optional AI Assistant (Runs 100% offline with deterministic fallbacks if unset)
AI_PROVIDER=none
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional Notification Dispatcher (Logs to console/audit trail if unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATION_FROM_EMAIL=notifications@documentready.gov.in
